{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "outDir": "../../../out-tsc/app2",
    "types": [],
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@epikodelabs/actionstack/tools": [
        "../../../dist/actionstack/tools",
        "../../../projects/libraries/actionstack/tools/src/public-api.ts"
      ],
      "@epikodelabs/actionstack": [
        "../../../dist/actionstack",
        "../../../projects/libraries/actionstack/src/public-api.ts"
      ]
    }
  },
  "include": ["src"]
}

