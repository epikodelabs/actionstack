{
  "name": "@epikodelabs/actionstack",
  "version": "3.0.22",
  "license": "AGPL-3.0-only",
  "description": "Next-generation state management for reactive applications, built on Streamix for performance and simplicity.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "react:serve": "vite --config projects/apps/app2/vite.config.ts",
    "react:build": "vite build --config projects/apps/app2/vite.config.ts",
    "watch": "ng build --watch --configuration development",
    "test": "npx testify",
    "minify": "node terser.mjs && npx typegen",
    "docs:generate": "node scripts/copy-vitepress-config.mjs && typedoc --plugin typedoc-plugin-markdown --out dist/api",
    "docs:prepare": "node scripts/docs-prepare.mjs",
    "docs:fix-api-links": "node scripts/fix-typedoc-links.mjs",
    "docs:dev": "npm run docs:prepare && npm run docs:generate && npm run docs:fix-api-links && vitepress dev dist",
    "docs:build": "npm run docs:prepare && npm run docs:generate && npm run docs:fix-api-links && vitepress build dist --base /actionstack/ && npm run docs:rewrite",
    "docs:rewrite": "node scripts/rewrite-vitepress-base.mjs"
  },
  "dependencies": {
    "@angular/animations": "^21.1.3",
    "@angular/common": "^21.1.3",
    "@angular/compiler": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/forms": "^21.1.3",
    "@angular/platform-browser": "^21.1.3",
    "@angular/platform-browser-dynamic": "^21.1.3",
    "@angular/router": "^21.1.3",
    "@epikodelabs/streamix": "^2.0.38",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.3",
    "@epikodelabs/testify": "^1.0.20",
    "@epikodelabs/typegen": "^1.0.13",
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.8",
    "@types/jasmine": "^6.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.2.2",
    "@vitejs/plugin-react": "^5.1.3",
    "dts-bundle-generator": "^9.5.1",
    "fast-glob": "^3.3.3",
    "jasmine-core": "^6.0.1",
    "ng-packagr": "^21.1.0",
    "strip-json-comments": "^5.0.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.28.16",
    "typedoc-plugin-markdown": "^4.10.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.0",
    "vitepress": "^1.6.4"
  },
  "type": "module"
}
